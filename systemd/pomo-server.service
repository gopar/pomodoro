# Pomodoro sync server (home-base machine ONLY) — systemd user service.
#
# Install (home-base only):
#   mkdir -p ~/.config/systemd/user
#   cp systemd/pomo-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now pomo-server
#   # keep the user service running after logout / across reboot:
#   loginctl enable-linger "$USER"
#
# Logs: journalctl --user -u pomo-server -f
# DB:   ~/.local/share/pomo/pomo.db (override with POMO_DB_PATH).
#
# Assumes the repo is deployed at ~/.config/pomo. Adjust ExecStart otherwise.

[Unit]
Description=Pomodoro sync server (home-base)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Hardcode the full python3 path (more reliable than ``/usr/bin/env``):
ExecStart=/opt/homebrew/bin/python3 %h/.config/pomo/server.py
Restart=on-failure
RestartSec=5
Environment=POMO_PORT=8787
Environment=POMO_HOST=0.0.0.0
# Uncomment to require a bearer token (also set it on every agent):
# Environment=POMO_TOKEN=change-me

[Install]
WantedBy=default.target
