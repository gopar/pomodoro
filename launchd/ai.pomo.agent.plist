<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pomodoro local agent (every machine).
  Install:
    cp ~/.config/pomo/launchd/ai.pomo.agent.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.pomo.agent.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/ai.pomo.agent.plist

  Configure server_url / machine_name / hooks in ~/.config/pomo/agent.toml
  (POMO_SERVER_URL below overrides agent.toml if set).

  UPDATE THE PYTHON3 PATH — replace /opt/homebrew/bin/python3 with the
  output of ``which python3`` if your python3 lives elsewhere
  (e.g. /usr/local/bin/python3 on Intel Macs).
  Likewise replace /Users/gopar with your home directory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.pomo.agent</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Hardcode the full python3 path (launchd's default PATH is too
             narrow for ``/usr/bin/env python3`` to find Homebrew python). -->
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>pomo.agent</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Optional override; otherwise agent.toml server_url is used.
        <key>POMO_SERVER_URL</key>
        <string>http://home-base:8787</string>
        -->
        <!-- If the server requires a token:
        <key>POMO_TOKEN</key>
        <string>change-me</string>
        -->
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Only restart on crash (non-zero exit), not on clean shutdown. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- Minimum interval between restarts to let TIME_WAIT sockets clear. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/pomo-agent.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pomo-agent.err.log</string>
</dict>
</plist>
