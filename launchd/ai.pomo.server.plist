<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pomodoro sync server (home-base machine only).
  Install:
    cp ~/.config/pomo/launchd/ai.pomo.server.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.pomo.server.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/ai.pomo.server.plist

  Adjust POMO_PORT / POMO_TOKEN below as needed.

  UPDATE THE PYTHON3 PATH — replace /opt/homebrew/bin/python3 with the
  output of ``which python3`` if your python3 lives elsewhere
  (e.g. /usr/local/bin/python3 on Intel Macs).
  Likewise replace /Users/gopar with your home directory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.pomo.server</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Hardcode the full python3 path (launchd's default PATH is too
             narrow for ``/usr/bin/env python3`` to find Homebrew python). -->
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>pomo.server</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>POMO_PORT</key>
        <string>8787</string>
        <key>POMO_HOST</key>
        <string>0.0.0.0</string>
        <!-- Uncomment to require a bearer token:
        <key>POMO_TOKEN</key>
        <string>change-me</string>
        -->
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Only restart on crash (non-zero exit), not on clean shutdown.
         Prevents restart storms when the process exits intentionally. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- Minimum interval between restarts to let TIME_WAIT sockets clear. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/pomo-server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pomo-server.err.log</string>
</dict>
</plist>
