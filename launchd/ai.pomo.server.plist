<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pomodoro sync server (home-base machine only).
  Install:
    cp ~/.config/pomo/launchd/ai.pomo.server.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.pomo.server.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/ai.pomo.server.plist
  Adjust POMO_PORT / POMO_TOKEN below as needed.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.pomo.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/gopar/.config/pomo/server.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>POMO_PORT</key>
        <string>8787</string>
        <key>POMO_HOST</key>
        <string>0.0.0.0</string>
        <!-- Uncomment to require a bearer token:
        <key>POMO_TOKEN</key>
        <string>change-me</string>
        -->
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/pomo-server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pomo-server.err.log</string>
</dict>
</plist>
